# EdgeErgo V3 — Backend Environment Variables (Local Template)
# Never put real production secrets in this file or commit .env to git.

APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Auth configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Database access via least-privilege dedicated role
DATABASE_URL=postgresql+asyncpg://edgeergo_api_user:password@localhost:5432/postgres
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/edgeergo_test

# Operational & Security bounds
LOG_LEVEL=INFO
ENROLLMENT_TOKEN_TTL_MINUTES=15
MAX_BATCH_SIZE=100
MAX_EXPORT_ROWS=10000
ENABLE_API_DOCS=true

# OPTIONAL server-only variable (NOT required for standard pooled least-privilege DB operations)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-if-explicitly-needed
