# EdgeErgo V3 — Root Environment Variables Example
# Reference templates for subprojects. Do not put real secrets here.

# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend (FastAPI)
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_URL=postgresql+asyncpg://edgeergo_api_user:password@localhost:5432/postgres
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/edgeergo_test
LOG_LEVEL=INFO
ENROLLMENT_TOKEN_TTL_MINUTES=15
MAX_BATCH_SIZE=100
MAX_EXPORT_ROWS=10000
ENABLE_API_DOCS=true
# OPTIONAL server-only key. NOT required for standard operation using direct least-privilege DB role.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-if-needed

# Edge Agent
EDGE_ERGO_API_BASE_URL=http://127.0.0.1:8000
EDGE_ERGO_DATA_DIR=~/.edge_ergo
EDGE_ERGO_LOG_LEVEL=INFO
