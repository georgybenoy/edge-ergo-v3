# EdgeErgo V3 — Windows Edge Agent Configuration (Local Template)
# No secrets, administrator keys, or raw media capture paths should be placed here.
# Workstation credentials are provisioned during enrollment and stored in Windows Credential Manager.

EDGE_ERGO_API_BASE_URL=http://127.0.0.1:8000
EDGE_ERGO_DATA_DIR=~/.edge_ergo
EDGE_ERGO_LOG_LEVEL=INFO
